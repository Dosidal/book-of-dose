     },
     "value": "GS1 DataMatrix with GTIN and serial number (S.R.O. 470(I)/2017)"
    },
    {
     "label": "Rule",
     "read_at": "2026-11-16",
     "source": {
      "publisher": "Drug Regulatory Authority of Pakistan",
      "url": "https://www.dra.gov.pk/wp-content/uploads/2026/06/Guideline-TT_v2.2.pdf"
     },
     "value": "DRAP guidelines implementing S.R.O. 470(I)/2017 require each secondary pack to carry a GS1 DataMatrix encoding (01) 14-digit GTIN, (17) expiry YYMMDD, (10) batch/lot up to 20 characters and (21) a unique serial number up to 20 characters; shipper cartons carry a DataMatrix and a GS1-128 SSCC, and primary packs are exempt at present."
    }
